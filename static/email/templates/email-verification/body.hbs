{{> header title="Confirma tu cuenta de Patilandia" }}

<mj-section background-color="#ffffff" padding="8px 24px 32px 24px">
    <mj-column>
        <mj-text>
            <h3>¡Bienvenido/a a Patilandia! 🐾</h3>
        </mj-text>
        <mj-text color="#5f6790">
            Gracias por crear tu cuenta. Confirma tu correo para terminar el registro y empezar a
            comprar todo lo que tu mascota necesita.
        </mj-text>

        <mj-button href="{{ verifyEmailAddressUrl }}?token={{ verificationToken }}">
            Confirmar mi correo
        </mj-button>

        <mj-text color="#5f6790" font-size="13px">
            Si tú no creaste esta cuenta, puedes ignorar este correo tranquilamente.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
