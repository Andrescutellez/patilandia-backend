{{> header title="Confirmación de tu regalo" }}

<mj-raw>
    <style type="text/css">
    .callout {
        background-color: #7261ff;
        padding: 18px 0;
    }
    .callout-large > div {
        text-align: center !important;
        color: #fff !important;
        font-size: 13px !important;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: bold;
        padding: 0;
    }
    .callout-small > div {
        text-align: center !important;
        color: #fff !important;
        font-size: 16px !important;
        font-weight: bold;
        padding: 4px 0 0 0;
    }
    ul.address {
        list-style-type: none;
        padding: 0;
        margin: 0;
    }
    .bg-off-white {
        background-color: #fafafa;
    }
    .gift-box {
        background-color: #fff8e8;
        border-radius: 12px;
        padding: 16px;
    }
    </style>
</mj-raw>

<mj-section css-class="bg-off-white" padding="8px 24px 24px 24px">
    <mj-column>
        <mj-text>
            <h3>🎁 ¡Tu regalo está confirmado, {{ order.customer.firstName }}!</h3>
        </mj-text>
        <mj-text color="#5f6790">
            Ya confirmamos el pago y estamos preparando tu regalo con cariño. Te avisamos por acá
            apenas salga y cuando llegue a destino.
        </mj-text>
    </mj-column>
</mj-section>

<mj-section css-class="callout">
    <mj-column>
        <mj-text css-class="callout-large">Número de pedido</mj-text>
        <mj-text css-class="callout-small">{{ order.code }}</mj-text>
    </mj-column>
    <mj-column>
        <mj-text css-class="callout-large">Fecha</mj-text>
        <mj-text css-class="callout-small">{{ formatDate order.orderPlacedAt "dd/mm/yyyy" }}</mj-text>
    </mj-column>
    <mj-column>
        <mj-text css-class="callout-large">Total</mj-text>
        <mj-text css-class="callout-small">{{ formatMoney order.totalWithTax order.currencyCode 'es-CO' }}</mj-text>
    </mj-column>
</mj-section>

<mj-section css-class="bg-off-white" padding="24px 24px 0 24px">
    <mj-column>
        <mj-text css-class="gift-box">
            <strong>Detalles del regalo</strong><br /><br />
            {{#if giftWrap}}✅ Va envuelto para regalo.<br />{{else}}Sin envoltorio especial.<br />{{/if}}
            {{#unless giftAnonymous}}
                {{#if giftSenderName}}De parte de: <strong>{{ giftSenderName }}</strong><br />{{/if}}
            {{else}}
                Este regalo se envía de forma anónima — el destinatario no va a ver quién lo mandó.<br />
            {{/unless}}
            {{#if giftMessage}}
                <br /><em>"{{ giftMessage }}"</em>
            {{/if}}
        </mj-text>
        <mj-text color="#b45309" font-size="13px" padding-top="12px">
            ⚠️ Recuerda que el paquete se prepara sin incluir el precio a la vista, tal como pediste.
        </mj-text>
    </mj-column>
</mj-section>

<mj-section css-class="bg-off-white" padding="16px 24px 24px 24px">
    <mj-column>
        {{#with order.shippingAddress }}
            <mj-text>
                <h3>Va para: {{ fullName }}</h3>
                <ul class="address">
                    {{#if streetLine1}}<li>{{ streetLine1 }}</li>{{/if}}
                    {{#if streetLine2}}<li>{{ streetLine2 }}</li>{{/if}}
                    {{#if city}}<li>{{ city }}{{#if province}}, {{ province }}{{/if}}</li>{{/if}}
                    {{#if country}}<li>{{ country }}</li>{{/if}}
                    {{#if phoneNumber}}<li>{{ phoneNumber }}</li>{{/if}}
                </ul>
            </mj-text>
        {{/with}}
    </mj-column>
</mj-section>

<mj-section padding="0 24px 24px 24px">
    <mj-column>
        <mj-text>
            <h3>Resumen del pedido</h3>
        </mj-text>
        <mj-table cellpadding="8px">
            {{#each order.lines }}
                <tr>
                    <td style="width: 56px; border-bottom: 1px dashed #e5e0ff;">
                        <img alt="{{ productVariant.name }}"
                             style="width: 48px; height: 48px; border-radius: 10px; object-fit: cover;"
                             src="{{ featuredAsset.preview }}?w=48&h=48" />
                    </td>
                    <td style="border-bottom: 1px dashed #e5e0ff;">{{ quantity }} x {{ productVariant.name }}</td>
                    <td style="border-bottom: 1px dashed #e5e0ff; text-align: right; white-space: nowrap;">{{ formatMoney discountedLinePriceWithTax ../order.currencyCode 'es-CO' }}</td>
                </tr>
            {{/each}}
            <tr>
                <td colspan="2" style="font-weight: bold;">Total</td>
                <td style="font-weight: bold; text-align: right; white-space: nowrap;">{{ formatMoney order.totalWithTax order.currencyCode 'es-CO' }}</td>
            </tr>
        </mj-table>
    </mj-column>
</mj-section>

<mj-section padding="0 24px 32px 24px">
    <mj-column>
        <mj-button href="{{ storefrontUrl }}/pedido/{{ order.code }}">
            Ver tu pedido
        </mj-button>
    </mj-column>
</mj-section>

{{> footer }}
