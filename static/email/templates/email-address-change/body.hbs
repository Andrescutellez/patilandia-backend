{{> header title="Confirma tu nuevo correo" }}

<mj-section background-color="#ffffff" padding="8px 24px 32px 24px">
    <mj-column>
        <mj-text>
            <h3>Cambio de correo en tu cuenta</h3>
        </mj-text>
        <mj-text color="#5f6790">
            Recibimos una solicitud para cambiar el correo de tu cuenta de Patilandia a esta
            dirección. Confírmalo para completar el cambio.
        </mj-text>

        <mj-button href="{{ changeEmailAddressUrl }}?token={{ identifierChangeToken }}">
            Confirmar nuevo correo
        </mj-button>

        <mj-text color="#5f6790" font-size="13px">
            Si no pediste este cambio, puedes ignorar este correo — tu correo actual sigue siendo
            el mismo.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
