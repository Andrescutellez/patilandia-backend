APP_ENV=dev
VENDURE_SERVER_PORT=3000
COOKIE_SECRET=
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin
# Comma-separated list of browser origins allowed to make credentialed API requests,
# e.g. https://example.com,https://admin.example.com
# Only used when APP_ENV is not "dev". Leave empty in local development.
CORS_ORIGINS=
DB_HOST=localhost
DB_PORT=6543
DB_NAME=vendure
DB_USERNAME=vendure
DB_PASSWORD=
DB_SCHEMA=public
# Bold (pasarela de pago, Colombia) — llaves de sandbox, https://developers.bold.co
BOLD_IDENTITY_KEY=
BOLD_SECRET_KEY=
BOLD_SANDBOX=true

# Base URL of the storefront — used to build every link inside transactional emails that the
# recipient *clicks* (account verification, password reset, Patipuntos, order links). Points at
# whichever environment sent the email, since that's where the recipient's account/session lives —
# so it's fine (and expected) for this to be localhost in local dev.
STOREFRONT_URL=http://localhost:3001

# Base URL for static assets *embedded* inside emails (today: the logo in partials/header.hbs).
# Deliberately separate from STOREFRONT_URL: an <img> is fetched by the recipient's mail client the
# instant they open the email, from wherever they are — it can never be a localhost/dev URL, even
# when the email itself was sent from a dev/staging backend. Defaults to the real production
# storefront if unset, since the logo doesn't vary by environment.
EMAIL_ASSET_BASE_URL=https://patilandia.com.co

# Email (Purelymail SMTP) — leaving SMTP_HOST empty keeps EmailPlugin in devMode (emails are
# written to disk and viewable at /mailbox instead of actually sent), which is fine for local
# development. Set all five SMTP_* vars to send real mail.
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=leonardocuadros@patilandia.com.co
SMTP_PASSWORD=

# EMAIL_FROM_NAME is the display name used for every sender identity below (e.g. "Patilandia").
# EMAIL_FROM_ADDRESS is the fallback/"principal" identity for anything that doesn't fit one of the
# 5 categories below. EMAIL_REPLY_TO is where a customer's reply actually lands.
EMAIL_FROM_NAME=Patilandia
EMAIL_FROM_ADDRESS=pedidos@patilandia.com.co
EMAIL_REPLY_TO=pedidos@patilandia.com.co

# Purelymail aliases (all deliver to the same two real mailboxes) — see src/email/senders.ts for
# which email type uses which address.
EMAIL_ADDRESS_PEDIDOS=pedidos@patilandia.com.co
EMAIL_ADDRESS_VENTAS=ventas@patilandia.com.co
EMAIL_ADDRESS_SOPORTE=soporte@patilandia.com.co
EMAIL_ADDRESS_HOLA=hola@patilandia.com.co
EMAIL_ADDRESS_CONTACTO=contacto@patilandia.com.co
